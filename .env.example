# RAG Demo Configuration
# Copy this file to .env and fill in your values
# All values shown here are the default values if not specified

# =============================================================================
# Server Settings
# =============================================================================
PORT=3000

# =============================================================================
# Search Configuration
# =============================================================================
# How many semantic search results to fetch before reranking
SEMANTIC_SEARCH_LIMIT=5

# How many keyword search results to fetch before reranking (PostgreSQL)
PG_SEARCH_LIMIT=10

# Maximum number of documents to include in the final context
MAX_CONTEXT_DOCS=3

# Maximum size of a single document in characters
MAX_DOCUMENT_SIZE=10240

# =============================================================================
# Reranking Configuration
# =============================================================================
# Minimum score (0.0-1.0) to include document results after reranking
# Lower values include more results, higher values are more selective
RERANK_THRESHOLD=0.02

# Minimum score (0.0-1.0) to include code results after reranking
CODE_RERANK_THRESHOLD=0.05

# Minimum semantic similarity score for code relationships
CODE_SIMILARITY_SCORE=0.05

# Disable reranking entirely (for debugging/performance testing)
DISABLE_RERANKER=false

# =============================================================================
# File System
# =============================================================================
# Directory containing markdown documents
DOCUMENTS_DIR=./documents

# Code source directory for ingestion
CODE_SOURCE_DIRECTORY=src
CODE_SKIP_DIRECTORIES=node_modules,.git,dist,build,coverage,tests
CODE_EXTENSIONS=ts,tsx,js,jsx

# =============================================================================
# Database Configuration (PostgreSQL)
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rag_demo
DB_USER=rag_user
DB_PASSWORD=your_password_here

# =============================================================================
# Model Provider Configuration
# =============================================================================
# Choose between 'lm_studio' (local API) or 'openai' (cloud API)
# All following model settings must match your chosen provider
MODEL_PROVIDER=lm_studio

# LM Studio Configuration (local API - requires LM Studio running at LM_STUDIO_URL)
# Get models from: https://lmstudio.ai/
LM_STUDIO_URL=http://localhost:1234/v1
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHAT_MODEL=neural-chat

# OpenAI Configuration (only needed if MODEL_PROVIDER=openai)
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_key_here
OPENAI_MODEL=gpt-4
OPENAI_API_URL=https://api.openai.com/v1
