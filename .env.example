# Model Provider: "openai" or "lm_studio"
MODEL_PROVIDER=lm_studio

# OpenAI Configuration (only needed if MODEL_PROVIDER=openai)
OPENAI_API_KEY={your_openai_api_key_here}
OPENAI_MODEL=gpt-4 # example: gpt-4 or any other supported OpenAI model
OPENAI_API_URL=https://api.openai.com/v1 # default OpenAI API base URL

# CODE CONFIG BELOW
CODE_SOURCE_DIRECTORY=src
CODE_SKIP_DIRECTORIES=node_modules,.git,dist,build,coverage,tests
CODE_EXTENSIONS=ts,tsx,js,jsx

# LM STUDIO CONFIG BELOW
LM_STUDIO_URL=http://localhost:1234/v1 # Included if you're using LM Studio
EMBEDDING_MODEL={YOUR_MODEL_NAME_HERE} # example: text-embedding-nomic-embed-text-v1.5@q4_k_m
CHAT_MODEL={YOUR_CHAT_MODEL_HERE} # example: qwen/qwen3.5-9b

# POSTGRESQL INFO BELOW
DB_NAME={YOUR_DB_NAME_HERE}
DB_HOST={YOUR_DB_HOST_HERE} # USUALLY localhost
DB_PORT=5432 # USUALLY 5432
DB_USER={YOUR_DB_USER_HERE}
DB_PASSWORD={YOUR_DB_PASSWORD_HERE}

# Node CONFIG BELOW
PORT=3000 # example: 3000 | This port is for running node api

### Search Sensitivity Configuration (optional) ###
# These can be updated based on your search sensitivity requirements
PG_SEARCH_LIMIT=10 # sensitivity: higher = more candidates retrieved initially
RERANK_THRESHOLD=0.05 # sensitivity: higher = fewer docs used, lower = more permissive
CODE_RERANK_THRESHOLD=0.05 # same for code search
CODE_SIMILARITY_SCORE=0.05 # used in reranking
DISABLE_RERANKER=false # set to true to skip LLM reranking (uses semantic similarity only for faster performance)
MAX_CONTEXT_DOCS=3 # how many top docs sent to LLM
MAX_DOCUMENT_SIZE=10240 # max bytes per document to send to LLM (10kb)
SEMANTIC_SEARCH_LIMIT=10 # sensitivity: higher = more candidates retrieved initially for semantic search